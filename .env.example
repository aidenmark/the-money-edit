# Copy this file to .env and fill in the value. .env is gitignored.
#
# Create an internal integration at https://www.notion.so/my-integrations
# then open the Money Edit database in Notion, use the ... menu, choose
# Connections, and add the integration. Without that connection step the API
# returns an empty list rather than an error, which is easy to misread as a
# code bug.
NOTION_TOKEN=ntn_your_internal_integration_secret_here
